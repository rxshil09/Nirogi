{
  "name": "@nirogi/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/worker.ts",
    "scrape": "tsx --env-file=../../.env src/cli.ts",
    "prebuild": "npm --workspace=@nirogi/contracts run build && npm --workspace=@nirogi/domain run build && npm --workspace=@nirogi/config run build",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@nirogi/config": "*",
    "@nirogi/contracts": "*",
    "@nirogi/domain": "*",
    "@prisma/client": "^6.9.0",
    "bullmq": "^5.56.3",
    "playwright": "^1.51.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3"
  }
}

