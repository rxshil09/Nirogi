# API
API_PORT=4000
WEB_ORIGIN=http://localhost:5173

# PostgreSQL: provide the real connection string when the database is ready.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nirogi?sslmode=require

# Redis: required for BullMQ job queue. Leave blank to run without queuing (CLI scrape only).
REDIS_URL=redis://localhost:6379

# Optional SerpAPI key for Netmeds/PharmEasy product URL discovery.
SERPAPI_API_KEY=

# Worker
SCRAPER_HEADLESS=true
