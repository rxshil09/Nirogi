# API
API_PORT=4000
WEB_ORIGIN=http://localhost:5173

# PostgreSQL Credentials (used by docker-compose) & Connection String
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=nirogi_prod
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/nirogi?sslmode=require

# Redis: required for BullMQ job queue. Leave blank to run without queuing (CLI scrape only).
REDIS_URL=redis://localhost:6379

# Optional SerpAPI key for Netmeds/PharmEasy product URL discovery.
SERPAPI_API_KEY=

# Worker
SCRAPER_HEADLESS=true

